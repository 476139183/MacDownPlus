{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MacDownPlus",
  "version": "0.1.4",
  "identifier": "io.github.476139183.macdownrust",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MacDownPlus",
        "width": 1024,
        "height": 650,
        "minWidth": 360,
        "minHeight": 240,
        "titleBarStyle": "Visible",
        "hiddenTitle": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: https: http:; font-src 'self' data: https:; connect-src 'self' ipc: http://ipc.localhost https:; frame-src 'self' about: blob:; object-src 'none'; base-uri 'none'",
      "dangerousDisableAssetCspModification": [
        "script-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "A Rust and Tauri Markdown editor inspired by MacDown",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "name": "Markdown",
        "role": "Editor"
      }
    ],
    "resources": {
      "../third-party/": "third-party/",
      "../ACKNOWLEDGEMENTS.md": "ACKNOWLEDGEMENTS.md",
      "../LICENSE": "LICENSE"
    }
  }
}
