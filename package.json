{
  "name": "macdownplus",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "build:mac": "tauri build --features custom-protocol --target aarch64-apple-darwin --bundles app,dmg",
    "test:ui": "cargo build -p macdown-core --example render-json && playwright test",
    "test:core": "cargo test -p macdown-core",
    "test:native": "python3 scripts/native-smoke.py"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language-data": "^6.5.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "@tauri-apps/api": "^2.10.0",
    "codemirror": "^6.0.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/autocomplete": "^6.18.0",
    "@lezer/highlight": "^1.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tauri-apps/cli": "2.12.4",
    "typescript": "^5.9.0",
    "vite": "8.3.8",
    "prettier": "^3.9.10"
  }
}
